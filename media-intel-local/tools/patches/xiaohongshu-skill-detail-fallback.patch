+    def _extract_dom_detail(self, feed_id: str) -> Optional[Dict[str, Any]]:
+        """从详情页 DOM 兜底提取标题、正文、图片和互动数据。"""
+        page = self.client.page
+        result = page.evaluate("""(fid) => {
+            const pickText = (selectors) => {
+                for (const selector of selectors) {
+                    const el = document.querySelector(selector);
+                    const text = el && el.textContent ? el.textContent.trim() : '';
+                    if (text) return text;
+                }
+                return '';
+            };
+            const title = pickText(['#detail-title', '.title', '.note-content .title', '[class*="title"]']);
+            let desc = pickText(['#detail-desc', '.desc', '.note-content .desc', '.note-text', '[class*="desc"]']);
+            if (!desc) {
+                const content = document.querySelector('.note-content');
+                desc = content && content.textContent ? content.textContent.trim() : '';
+            }
+            const dateText = pickText(['.date', '.bottom-container .date', '[class*="date"]']);
+            const images = Array.from(document.querySelectorAll('img'))
+                .map(img => img.currentSrc || img.src || img.getAttribute('src') || '')
+                .filter(src => src && !src.includes('avatar') && !src.includes('data:image'))
+                .slice(0, 20)
+                .map(src => ({ urlDefault: src }));
+            if (!title && !desc && images.length === 0) return '';
+            return JSON.stringify({
+                note: { noteId: fid, title, desc, timeText: dateText, imageList: images, interactInfo: {} },
+                detail_status: 'dom_fallback'
+            });
+        }""", feed_id)
+        if not result:
+            return None
+        try:
+            return json.loads(result)
+        except json.JSONDecodeError:
+            return None
+
+    def _has_detail_content(self, detail: Optional[Dict[str, Any]]) -> bool:
+        if not isinstance(detail, dict):
+            return False
+        note = detail.get("note")
+        if not isinstance(note, dict):
+            return False
+        title = str(note.get("title") or note.get("displayTitle") or "").strip()
+        desc = str(note.get("desc") or note.get("description") or note.get("content") or "").strip()
+        images = note.get("imageList") or note.get("images") or []
+        return bool(title or desc or images)
+
